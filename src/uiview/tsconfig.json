{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["**/*.ts", "**/*.d.ts"],
  // Tests must never emit into the source tree: schemas.package.json ships
  // `src/uiview/**/*.js`, so a compiled *.test.js sitting here would be
  // published. They build via tsconfig.test.json into a scratch dir instead.
  "exclude": ["**/*.test.ts"]
}
